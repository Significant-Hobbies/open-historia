---
// Hero — LCP surface.
//
// The H1 ("OPEN HISTORIA") is the LCP element. Rendered in Playfair
// Display 900 with wide letter-spacing to echo the in-game OG image
// (app/opengraph-image.tsx → `letterSpacing: 8`).
//
// Single CTA points at /play. The Worker currently owns / and renders
// the game there — see README cutover notes. The /play move has to
// happen before Pages can take / for this landing.
---

<section class="oh-hero">
  <div class="oh-hero-frame" aria-hidden="true"></div>

  <div class="oh-eyebrow">
    <span class="oh-eyebrow-dot" aria-hidden="true"></span>
    Playable AI grand-strategy experiment
  </div>

  <h1 class="oh-hero-h1">
    Open <em>Historia</em>
  </h1>

  <div class="oh-hero-divider" aria-hidden="true"></div>

  <p class="oh-hero-tagline">
    Rewrite history. Command nations in plain English.
  </p>

  <p class="oh-hero-sub">
    Type &ldquo;invade Bohemia&rdquo; or &ldquo;send envoy to the Ottoman court.&rdquo;
    An AI Game Master moves armies, shifts treaties, and remembers your campaign
    across 20+ scenarios from 793 AD to 2040. The core loop is playable; the map
    and campaign pacing are still prototype-grade.
  </p>

  <div class="oh-hero-actions">
    <a href="/play" class="oh-btn-primary" data-app-health-event="hero.play.clicked">
      Pick a scenario and start <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <p class="oh-hero-fine">
    No account required &middot; free AI option &middot; bring your own key &middot;
    <a href="https://github.com/sarthakagrawal927/open-historia" class="oh-icon-link" aria-label="GitHub repository" title="GitHub repository" data-app-health-event="repository.opened" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a>
  </p>
</section>
