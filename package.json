{
  "name": "open-historia",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n worker,vite -c blue,green \"wrangler dev\" \"vite\"",
    "dev:fe": "vite",
    "dev:worker": "wrangler dev",
    "generate:discovery": "node scripts/generate-public-discovery.ts",
    "build": "pnpm generate:discovery && vite build",
    "cf:build": "pnpm build && pnpm --filter ./landing-astro build && node scripts/overlay-astro-landing.mjs",
    "validate:env:deploy": "node scripts/validate-env.mjs deploy",
    "deploy": "pnpm validate:env:deploy && pnpm cf:build && wrangler deploy --tag \"$(git rev-parse HEAD)\"",
    "lint": "eslint components lib src scripts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check ."
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "@anthropic-ai/sdk": "^0.91.0",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@google/generative-ai": "^0.24.1",
    "@saas-maker/app-health": "https://github.com/sass-maker/app-health/releases/download/node-v0.4.0/saas-maker-app-health-0.4.0.tgz",
    "@saas-maker/feedback": "^0.2.1",
    "ai": "6.0.168",
    "better-auth": "^1.6.9",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.15",
    "maplibre-gl": "^5.24.0",
    "posthog-js": "^1.372.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-map-gl": "^8.1.1",
    "react-router-dom": "^7.9.4",
    "topojson-client": "^3.1.0",
    "workers-ai-provider": "3.3.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@cloudflare/workers-types": "^4.20260424.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "tailwindcss": "^4.2.4",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.13",
    "vitest": "4.1.5",
    "wrangler": "^4.85.0"
  }
}
